// Создаем объект FileSystemObject для работы с файлами в среде Windows Script Host (WSH)
var fso = new ActiveXObject("Scripting.FileSystemObject");

/**
 * Функция buildBadCharTable(pattern)
 * Строит таблицу сдвигов по правилу «плохого символа» (Bad Character Rule).
 * Если символ в тексте не совпадает с символом в шаблоне, мы можем безопасно
 * сдвинуть шаблон так, чтобы этот «плохой» символ текста совпал с его последним
 * вхождением в шаблоне (или уйти за пределы шаблона, если такого символа нет).
 *
 * @param {string} pattern - искомый шаблон (подстрока)
 * @returns {Object} - таблица: table[символ] = величина сдвига
 */

function buildBadCharTable(pattern) {
    var table = {};
    var m = pattern.length;

    // Проходим по всем символам шаблона слева направо
    for (var i = 0; i < m; i++) {
        var ch = pattern.charAt(i);
        
        // Вычисляем сдвиг: расстояние от текущей позиции до конца шаблона минус 1.
        // Формула: (m - 1) - i, но в коде ниже используется m - i - 1.
        // Например, для шаблона "ABC":
        //   'A' (i=0): сдвиг = 3 - 0 - 1 = 2 (если встретили 'A', можно сдвинуть на 2 позиции)
        //   'B' (i=1): сдвиг = 3 - 1 - 1 = 1
        //   'C' (i=2): сдвиг = 3 - 2 - 1 = 0 (но мы берем минимум 1, чтобы не застрять)
        var shift = Math.max(1, m - i - 1);
        
        // В таблицу записывается сдвиг для данного символа.
        // Важный нюанс: если символ встречается в шаблоне несколько раз,
        // в этой простой реализации сохранится сдвиг для его последнего вхождения,
        // потому что цикл идет слева направо и перезаписывает значения.
        table[ch] = shift;
    }

    return table;
}

/**
 * Функция printBadCharTable(pattern, table)
 * Красиво выводит таблицу сдвигов в консоль, показывая только уникальные символы.
 *
 * @param {string} pattern - шаблон
 * @param {Object} table - таблица сдвигов
 */
function printBadCharTable(pattern, table) {
    WScript.Echo("Shift table (Bad Character Rule):");
    
    var displayed = {}; // Вспомогательный объект, чтобы не выводить один символ дважды
    
    for (var i = 0; i < pattern.length; i++) {
        var ch = pattern.charAt(i);
        
        // Если этот символ еще не выводили, печатаем его сдвиг
        if (!displayed[ch]) {
            WScript.Echo("  '" + ch + "' -> shift by " + table[ch] + " positions");
            displayed[ch] = true;
        }
    }
}

/**
 * Функция searchBadChar(text, pattern)
 * Выполняет поиск всех вхождений шаблона в тексте, используя правило плохого символа.
 * Это упрощенная версия алгоритма Бойера-Мура (без правила хорошего суффикса).
 *
 * @param {string} text - текст для поиска
 * @param {string} pattern - искомый шаблон
 * @returns {Array} - массив начальных индексов (0-based) найденных вхождений
 */
function searchBadChar(text, pattern) {
    var n = text.length;      // Длина текста
    var m = pattern.length;   // Длина шаблона
    
    // Строим таблицу сдвигов заранее
    var badCharTable = buildBadCharTable(pattern);
    
    var results = []; // Массив для хранения позиций найденных подстрок
    
    // Начинаем поиск с позиции m - 1 (конец первого потенциального окна в тексте)
    var i = m - 1;

    // Пока текущая позиция i находится в пределах текста
    while (i < n) {
        var j = m - 1; // Индекс символа в шаблоне (начинаем сравнение с конца)
        var k = i;     // Индекс символа в тексте (соответствует j)

        // Внутренний цикл: сравниваем символы шаблона и текста справа налево
        // Продолжаем, пока не дойдем до начала шаблона (j >= 0) и пока символы совпадают
        while (j >= 0 && text.charAt(k) === pattern.charAt(j)) {
            j--;
            k--;
        }

        // Если j < 0, значит, мы успешно прошли весь шаблон и все символы совпали
        if (j < 0) {
            // k сейчас указывает на позицию перед началом совпадения, поэтому начало = k + 1
            results.push(k + 1);
            
            // После нахождения совпадения сдвигаем окно на 1 позицию вперед,
            // чтобы искать следующее вхождение (в этой реализации).
            i++;
        } else {
            // Если совпадение не полное, мы остановились на «плохом символе».
            // text.charAt(k) — это символ в тексте, который не совпал с pattern.charAt(j)
            var badChar = text.charAt(k);
            
            // Получаем величину сдвига из таблицы.
            // Если символа badChar нет в таблице (он не встречался в шаблоне),
            // используем безопасный сдвиг на всю длину шаблона (m).
            var shift = badCharTable[badChar] || m;
            
            // Сдвигаем основную позицию i на величину shift
            i += shift;
        }
    }
    
    return results;
}

// --- Основная программа (скрипт для WSH) ---

WScript.Echo("\nEnter the file name with a string: ");
// Читаем имя файла из стандартного ввода (консоли)
var fileName = WScript.StdIn.ReadLine();
var text = "";

// Проверяем существование файла и читаем его содержимое
if (fso.FileExists(fileName)) {
    // Открываем файл для чтения (режим 1 = ForReading)
    var file = fso.OpenTextFile(fileName, 1);
    text = file.ReadAll();
    file.Close();
    WScript.Echo("The text has been successfully loaded from the file: " + fileName);
} else {
    WScript.Echo("File " + fileName + " not found.");
    WScript.Echo("End of work.");
    WScript.Quit(); // Завершаем скрипт, так как файла нет
}

WScript.Echo("\nEnter the search substring:");
var pattern = WScript.StdIn.ReadLine();

// Проверка на пустую подстроку
if (!pattern || pattern.length === 0) {
    WScript.Echo("The substring cannot be empty!");
    WScript.Quit();
}

// Строим и выводим таблицу сдвигов для наглядности
var badCharTable = buildBadCharTable(pattern);
printBadCharTable(pattern, badCharTable);

// Замеряем время начала поиска
var startTime = new Date().getTime();

// Выполняем поиск
var results = searchBadChar(text, pattern);

// Замеряем время окончания поиска
var endTime = new Date().getTime();

WScript.Echo("\n=== Search results ===");
WScript.Echo("Substring: \"" + pattern + "\"");
WScript.Echo("Search time: " + (endTime - startTime) + " ms");

if (results.length === 0) {
    WScript.Echo("The substring was not found.");
} else {
    WScript.Echo("Occurrences have been detected: " + results.length);
    WScript.Echo("Positions (0-based index):");
    
    // Показываем не более 10 первых позиций, чтобы не засорять консоль
    var maxShow = 10;
    var toShow = Math.min(results.length, maxShow);
    
    for (var i = 0; i < toShow; i++) {
        WScript.Echo("  Position " + results[i]);
    }
    
    if (results.length > maxShow) {
        WScript.Echo("... and " + (results.length - maxShow) + " more occurrences.");
    }
}
