// Создаем объект FileSystemObject для работы с файлами в среде Windows Script Host (WSH)
var fso = new ActiveXObject("Scripting.FileSystemObject");

/**
 * Функция buildAutomaton(pattern)
 * Строит таблицу переходов (delta) для конечного детерминированного автомата,
 * который распознает заданный шаблон (pattern).
 * 
 * @param {string} pattern - искомый шаблон (подстрока)
 * @returns {Array} - двумерная структура: delta[состояние][символ] = следующее_состояние
 */

function buildAutomaton(pattern) {
    var m = pattern.length;          // Длина шаблона (максимальное состояние автомата)
    var alphabet = {};               // Словарь уникальных символов в шаблоне (алфавит автомата)
    
    // Заполняем алфавит: собираем все уникальные символы, встречающиеся в шаблоне
    for (var i = 0; i < m; i++) {
        alphabet[pattern.charAt(i)] = true;
    }
    
    // delta - это таблица переходов: delta[state][char] = newState
    // Создаем массив состояний от 0 до m (всего m+1 состояний)
    var delta = new Array(m + 1);
    for (var state = 0; state <= m; state++) {
        delta[state] = new Object(); // Для каждого состояния создаем объект переходов по символам
    }
    
    // Заполняем таблицу переходов для каждого состояния и каждого символа алфавита
    for (var state = 0; state <= m; state++) {
        for (var char in alphabet) {
            // Начинаем проверку с максимально возможного нового состояния
            // Оно не может быть больше длины шаблона и не больше (текущее состояние + 1)
            var k = Math.min(m, state + 1);
            
            // Ищем наибольшее k, такое что префикс шаблона длины k совпадает с суффиксом строки,
            // полученной добавлением символа char к префиксу длины state.
            // Это ключевой шаг алгоритма построения КДА для поиска подстрок.
            while (k > 0) {
                // Префикс шаблона длины k: первые k символов шаблона
                var prefix = pattern.substring(0, k);
                
                // Суффикс: берем последние (state) символов текущего префикса (до добавления char)
                // и добавляем текущий символ char. 
                // pattern.substring(state + 1 - k, state) берет последние (k-1) символов префикса длины state
                // (если state < k, substring корректно обработает границы, но логика алгоритма подразумевает state >= k-1)
                var suffix = pattern.substring(state + 1 - k, state) + char;
                
                // Если префикс и суффикс совпадают, значит, мы нашли новое состояние k
                if (prefix === suffix) {
                    break; // Нашли подходящее k, выходим из цикла while
                }
                k--; // Иначе пробуем меньшую длину префикса
            }
            
            // Записываем найденное состояние перехода
            delta[state][char] = k;
        }
    }
    
    return delta;
}

/**
 * Функция search(text, pattern)
 * Ищет все вхождения шаблона pattern в тексте text с использованием построенного автомата.
 * 
 * @param {string} text - текст для поиска
 * @param {string} pattern - искомый шаблон
 * @returns {Array} - массив начальных позиций (индексов) найденных вхождений
 */
function search(text, pattern) {
    // Проверка на пустой шаблон
    if (pattern.length === 0) {
        WScript.Echo("Error: the substring is empty");
        return;
    }
    
    var m = pattern.length; // Длина шаблона
    var n = text.length;    // Длина текста
    
    // Строим автомат (таблицу переходов) заранее, чтобы не пересчитывать её для каждого символа текста
    var delta = buildAutomaton(pattern);
    
    var state = 0;                 // Начальное состояние автомата (0 означает, что совпадений пока нет)
    var positions = new Array();   // Массив для хранения индексов начала найденных подстрок
    
    // Проходим по каждому символу текста
    for (var i = 0; i < n; i++) {
        var char = text.charAt(i);
        
        // Если текущий символ есть в алфавите шаблона, переходим по таблице delta
        if (delta[state][char] !== undefined) {
            state = delta[state][char];
        } else {
            // Если символа нет в алфавите (или переход не определен), сбрасываем состояние в 0
            // В данной реализации, так как алфавит строится только по символам шаблона,
            // любой символ, не входящий в шаблон, приведет к этому блоку.
            state = 0;
        }
        
        // Если мы достигли состояния m, значит, шаблон полностью совпал с суффиксом прочитанной части текста
        if (state === m) {
            // Вычисляем индекс начала совпадения: текущий индекс минус длина шаблона плюс 1
            positions.push(i - m + 1);
            
            // После нахождения полного совпадения сбрасываем состояние в 0,
            // чтобы искать следующие вхождения независимо (без перекрытия).
            // Примечание: если нужно искать перекрывающиеся вхождения (например, "ana" в "banana"),
            // здесь нужно использовать значение delta[m][char] или специальную логику,
            // но в данной реализации выбран сброс в 0.
            state = 0;
        }
    }
    
    return positions;
}

// --- Основная программа (скрипт для WSH) ---

WScript.Echo("=== Substring search using the finite automaton method ===");

WScript.Echo("\nEnter the file name with a string: ");
// Читаем имя файла из стандартного ввода (консоли)
var fileName = WScript.StdIn.ReadLine();

// Проверяем существование файла
if (!fso.FileExists(fileName)) {
    WScript.Echo("Error: file '" + fileName + "' not found!");
    WScript.Quit(1); // Завершаем скрипт с кодом ошибки 1
}

// Открываем файл, читаем всё содержимое в переменную text, закрываем файл
var file = fso.OpenTextFile(fileName);
var text = file.ReadAll();
file.Close();

WScript.Echo("The text has been successfully loaded from the file. '" + fileName + "'");

WScript.StdOut.Write("\nEnter the search substring: ");
var pattern = WScript.StdIn.ReadLine();

// Проверка на пустую подстроку
if (!pattern || pattern.length === 0) {
    WScript.Echo("The substring cannot be empty!");
    WScript.Quit();
}

WScript.Echo("\nThe substring is being searched for. '" + pattern + "'...");

// Замеряем время начала поиска
var startTime = new Date().getTime();
var positions = search(text, pattern);
// Замеряем время окончания поиска
var endTime = new Date().getTime();

// Вывод результатов
if (positions.length === 0) {
    WScript.Echo("Substring '" + pattern + "' not found in the text.");
} else {
    WScript.Echo("Search time: " + (endTime - startTime) + " ms");
    WScript.Echo("Substring '" + pattern + "' found " + positions.length + " times:");
    
    // Показываем не более 10 первых позиций, чтобы не засорять консоль
    var maxShow = 10;
    var toShow = Math.min(positions.length, maxShow);
    
    for (var i = 0; i < toShow; i++) {
        WScript.Echo("  Position " + positions[i]);
    }
    
    if (positions.length > maxShow) {
        WScript.Echo("... and " + (positions.length - maxShow) + " more occurrences.");
    }
}

WScript.Echo("\nThe search is complete.");
